---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import portrait from '../assets/photos/portrait.jpg';
import { marquee, profile } from '../data/profile';
import { t, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const roles = profile.roles.map((r) => t(r, lang));
const chips = [
  { label: 'Python', x: '-6%', y: '14%', d: '0s' },
  { label: 'Docker', x: '78%', y: '6%', d: '-2s' },
  { label: 'IEC 61850', x: '82%', y: '70%', d: '-4s' },
  { label: 'Java', x: '-4%', y: '74%', d: '-1s' },
  { label: 'CI/CD', x: '36%', y: '-4%', d: '-3s' },
];
---

<section class="hero">
  <div class="aurora" aria-hidden="true">
    <span class="blob b1"></span>
    <span class="blob b2"></span>
    <span class="blob b3"></span>
  </div>
  <div class="grid-bg" aria-hidden="true"></div>

  <div class="container hero-grid">
    <div class="hero-text">
      <p class="availability"><span class="dot" aria-hidden="true"></span>{t(profile.availability, lang)}</p>
      <p class="hello">{t(ui.hero.hello, lang)}</p>
      <h1>Jonathan <span class="gradient-text">Simo Kuate</span></h1>
      <p class="role" aria-label={roles[0]}>
        <span class="typed" data-roles={JSON.stringify(roles)}>{roles[0]}</span><span class="caret" aria-hidden="true"></span>
      </p>
      <p class="tagline muted">{t(profile.tagline, lang)}</p>
      <div class="cta">
        <a href="#projets" class="btn btn-primary">{t(ui.hero.seeProjects, lang)} <Icon name="arrowRight" size={18} /></a>
        <a href={profile.cv} class="btn btn-ghost" download><Icon name="download" size={18} /> {t(ui.hero.downloadCv, lang)}</a>
      </div>
      <ul class="hero-socials">
        <li><a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a></li>
        <li><a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" size={20} /></a></li>
        <li><a href={`mailto:${profile.email}`} aria-label="E-mail"><Icon name="mail" size={20} /></a></li>
        <li><a href={profile.phoneHref} aria-label={profile.phone}><Icon name="phone" size={20} /></a></li>
      </ul>
    </div>

    <div class="visual" aria-hidden="true">
      <div class="ring">
        <div class="portrait">
          <Image src={portrait} alt="Jonathan Simo Kuate" widths={[320, 480, 720]} sizes="(max-width: 720px) 70vw, 340px" loading="eager" fetchpriority="high" />
        </div>
      </div>
      {chips.map((c) => (
        <span class="chip" style={`left:${c.x};top:${c.y};animation-delay:${c.d}`}>{c.label}</span>
      ))}
      <div class="status card">
        <span class="pulse"></span>
        <div>
          <strong>{lang === 'fr' ? 'Ouvert aux opportunités' : 'Open to opportunities'}</strong>
          <span class="muted">{lang === 'fr' ? 'Systèmes · DevOps · Validation' : 'Systems · DevOps · Validation'}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      {[...marquee, ...marquee].map((m) => (
        <span class="m-item"><Icon name="sparkles" size={14} /> {m}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 56px 0 0;
    overflow: hidden;
  }
  .aurora {
    position: absolute;
    inset: 0;
    pointer-events: none;
    filter: blur(70px);
    opacity: 0.55;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    animation: float 18s ease-in-out infinite;
  }
  .b1 {
    width: 520px;
    height: 520px;
    background: #14b8a6;
    top: -160px;
    right: 6%;
  }
  .b2 {
    width: 420px;
    height: 420px;
    background: #6366f1;
    top: 120px;
    right: 28%;
    animation-delay: -6s;
    opacity: 0.7;
  }
  .b3 {
    width: 360px;
    height: 360px;
    background: #a855f7;
    top: 260px;
    right: -6%;
    animation-delay: -12s;
    opacity: 0.6;
  }
  :global([data-theme='light']) .aurora {
    opacity: 0.28;
  }
  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-40px, 30px) scale(1.08); }
    66% { transform: translate(30px, -20px) scale(0.95); }
  }
  .grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 30%, #000 10%, transparent 70%);
    opacity: 0.5;
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
    align-items: center;
    min-height: calc(86vh - 68px);
    padding-bottom: 48px;
  }
  .availability {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elev) 80%, transparent);
    backdrop-filter: blur(8px);
    font-size: 0.85rem;
    font-weight: 500;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    animation: ping 2.2s infinite;
  }
  @keyframes ping {
    0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6); }
    70% { box-shadow: 0 0 0 9px rgba(34, 197, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
  }
  .hello {
    margin-top: 28px;
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.95rem;
  }
  h1 {
    font-size: clamp(2.7rem, 6.6vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.04;
    margin-top: 10px;
  }
  .role {
    font-size: clamp(1.2rem, 2.6vw, 1.7rem);
    font-weight: 600;
    margin-top: 16px;
    min-height: 1.5em;
    display: flex;
    align-items: center;
  }
  .caret {
    display: inline-block;
    width: 3px;
    height: 1.1em;
    margin-left: 4px;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .tagline {
    margin-top: 18px;
    max-width: 560px;
    font-size: 1.08rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .hero-socials {
    display: flex;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
  }
  .hero-socials a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-elev) 80%, transparent);
    color: var(--text-muted);
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .hero-socials a:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  /* Visuel */
  .visual {
    position: relative;
    aspect-ratio: 1;
    max-width: 420px;
    width: 100%;
    justify-self: center;
  }
  .ring {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    padding: 4px;
    background: conic-gradient(from var(--angle, 0deg), #5eead4, #818cf8, #c084fc, #fbbf24, #5eead4);
    animation: spin 10s linear infinite;
  }
  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  @keyframes spin {
    to { --angle: 360deg; }
  }
  .portrait {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 25%, var(--accent-soft), transparent 60%),
      var(--bg-elev);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .mono {
    font-family: var(--font-mono);
    font-size: clamp(3.5rem, 9vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .chip {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elev) 85%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    white-space: nowrap;
    animation: bob 6s ease-in-out infinite;
  }
  .chip:nth-of-type(odd) {
    color: var(--accent);
  }
  .chip:nth-of-type(even) {
    color: var(--accent-2);
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }
  .status {
    position: absolute;
    bottom: 2%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    box-shadow: var(--shadow);
    white-space: nowrap;
    background: color-mix(in srgb, var(--bg-elev) 90%, transparent);
    backdrop-filter: blur(10px);
  }
  .status div {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .status strong {
    font-size: 0.9rem;
  }
  .status span.muted {
    font-size: 0.78rem;
  }
  .pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #22c55e;
    animation: ping 2.2s infinite;
  }

  /* Bandeau */
  .marquee {
    position: relative;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-soft) 60%, transparent);
    overflow: hidden;
    padding: 16px 0;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track {
    display: flex;
    gap: 40px;
    width: max-content;
    animation: scroll 40s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .m-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .m-item :global(svg) {
    color: var(--accent);
  }
  @keyframes scroll {
    to { transform: translateX(-50%); }
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .visual {
      max-width: 340px;
      order: -1;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 28px;
    }
    .visual {
      max-width: 270px;
    }
    .chip {
      font-size: 0.7rem;
      padding: 6px 10px;
    }
    .status {
      padding: 10px 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blob,
    .ring,
    .chip,
    .track,
    .caret {
      animation: none;
    }
  }
</style>

<script>
  // Machine à écrire sur les intitulés de poste.
  const el = document.querySelector<HTMLElement>('.typed');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduce) {
    const roles: string[] = JSON.parse(el.dataset.roles || '[]');
    let i = 0;
    let pos = roles[0].length;
    let deleting = false;
    const tick = () => {
      const word = roles[i];
      if (!deleting) {
        pos++;
        if (pos > word.length) {
          deleting = true;
          setTimeout(tick, 2200);
          return;
        }
      } else {
        pos--;
        if (pos === 0) {
          deleting = false;
          i = (i + 1) % roles.length;
        }
      }
      el.textContent = roles[i].slice(0, pos);
      setTimeout(tick, deleting ? 35 : 70);
    };
    setTimeout(() => {
      deleting = true;
      tick();
    }, 2600);
  }
</script>

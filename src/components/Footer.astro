---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { t, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <p class="muted">© {year} · {t(ui.footer.built, lang)}</p>
    <ul class="socials">
      <li><a href={`mailto:${profile.email}`} aria-label="E-mail"><Icon name="mail" /></a></li>
      <li><a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" /></a></li>
      <li><a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" /></a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    margin-top: 120px;
    border-top: 1px solid var(--border);
    padding: 28px 0;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .inner p {
    font-size: 0.88rem;
  }
  .socials {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--text-muted);
  }
  .socials a:hover {
    color: var(--accent);
    background: var(--bg-soft);
  }
</style>

---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  alt: string;
  large?: boolean;
  eager?: boolean;
}
const { project, alt, large = false, eager = false } = Astro.props;
const h = project.hue;
// Montage : les premières captures défilent en fondu dans le téléphone.
const slides = project.shots?.slice(0, 4) ?? [];
// Captures d'application de bureau : même fondu, dans une fenêtre.
const screens = project.screens?.slice(0, 4) ?? [];
---

<div class:list={['cover', { large }]} style={`--h:${h}`}>
  {screens.length > 0 ? (
    <div class="window">
      <div class="win-bar" aria-hidden="true"><span></span><span></span><span></span><em>{project.name}</em></div>
      <div class="win-body">
        {screens.map((s, i) => (
          <Image
            src={s.src}
            alt={i === 0 ? alt : ''}
            class="slide"
            style={`animation-delay:${i * 3}s`}
            widths={[420, 640, 900]}
            sizes="(max-width: 640px) 80vw, 340px"
            loading={eager ? 'eager' : 'lazy'}
          />
        ))}
      </div>
    </div>
  ) : slides.length > 0 ? (
    <div class="phone">
      {slides.map((s, i) => (
        <Image
          src={s.src}
          alt={i === 0 ? alt : ''}
          class="slide"
          style={`animation-delay:${i * 3}s`}
          widths={[280, 420]}
          sizes="(max-width: 640px) 50vw, 240px"
          loading={eager ? 'eager' : 'lazy'}
        />
      ))}
    </div>
  ) : (
    <div class="glyph" aria-hidden="true">
      <span class="orbit"><Icon name={project.icon} size={large ? 64 : 48} /></span>
      <span class="code">{project.stack.slice(0, 3).join(' · ')}</span>
    </div>
  )}
</div>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: calc(var(--radius) - 4px);
    background:
      radial-gradient(120% 90% at 85% 0%, hsl(var(--h) 75% 55% / 0.4), transparent 60%),
      radial-gradient(90% 80% at 0% 100%, hsl(calc(var(--h) + 50) 70% 50% / 0.3), transparent 60%),
      var(--bg-soft);
    display: grid;
    place-items: center;
  }
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at center, #000 20%, transparent 75%);
    opacity: 0.6;
    pointer-events: none;
  }
  .phone {
    position: relative;
    z-index: 1;
    width: 40%;
    max-width: 230px;
    aspect-ratio: 390 / 845;
    margin-top: 16%;
    border-radius: 22px 22px 0 0;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    border: 6px solid #0c1116;
    border-bottom: 0;
    align-self: start;
    background: #0c1116;
    transition: transform 0.5s ease;
  }
  .window {
    position: relative;
    z-index: 1;
    width: 80%;
    margin-top: 9%;
    align-self: start;
    border-radius: 12px 12px 0 0;
    overflow: hidden;
    background: #0c1116;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    transition: transform 0.5s ease;
  }
  .large .window {
    width: 72%;
  }
  .win-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: #1b222b;
  }
  .win-bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ef4444;
  }
  .win-bar span:nth-child(2) { background: #f59e0b; }
  .win-bar span:nth-child(3) { background: #22c55e; }
  .win-bar em {
    margin-left: 8px;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #9aa4b2;
  }
  .win-body {
    position: relative;
    aspect-ratio: 1050 / 750;
    background: #f4f4f4;
  }
  .win-body :global(.slide),
  .phone :global(.slide) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: auto;
    opacity: 0;
    animation: slide 12s infinite;
  }
  .win-body :global(.slide:first-child),
  .phone :global(.slide:first-child) {
    opacity: 1;
  }
  @keyframes slide {
    0% { opacity: 0; transform: scale(1.04); }
    6% { opacity: 1; transform: scale(1); }
    25% { opacity: 1; }
    31% { opacity: 0; }
    100% { opacity: 0; }
  }
  .glyph {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    color: hsl(var(--h) 70% 42%);
    transition: transform 0.5s ease;
  }
  :global([data-theme='dark']) .glyph {
    color: hsl(var(--h) 85% 70%);
  }
  .orbit {
    position: relative;
    display: grid;
    place-items: center;
    width: 104px;
    height: 104px;
    border-radius: 50%;
    background: hsl(var(--h) 70% 50% / 0.12);
  }
  .large .orbit {
    width: 140px;
    height: 140px;
  }
  .orbit::before,
  .orbit::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1px dashed hsl(var(--h) 70% 55% / 0.5);
    animation: rotate 18s linear infinite;
  }
  .orbit::after {
    inset: -24px;
    border-style: dotted;
    animation-duration: 28s;
    animation-direction: reverse;
  }
  @keyframes rotate {
    to { transform: rotate(360deg); }
  }
  .code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    padding: 0 16px;
    text-align: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .phone :global(.slide),
    .win-body :global(.slide),
    .orbit::before,
    .orbit::after {
      animation: none;
    }
  }
</style>

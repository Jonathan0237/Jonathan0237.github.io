</style>

<script>
  // Retour depuis une page de mission ou de projet : on revient exactement où l'on était.
  const scrollKey = `home-scroll:${location.pathname}`;
  const store = {
    get: (k: string) => {
      try {
        return sessionStorage.getItem(k);
      } catch {
        return null;
      }
    },
    set: (k: string, v: string) => {
      try {
        sessionStorage.setItem(k, v);
      } catch {}
    },
    del: (k: string) => {
      try {
        sessionStorage.removeItem(k);
      } catch {}
    },
  };
  document
    .querySelectorAll<HTMLAnchorElement>('a[href*="/parcours/"], a[href*="/experience/"], a[href*="/projets/"], a[href*="/projects/"]')
    .forEach((a) => a.addEventListener('click', () => store.set(scrollKey, String(Math.round(scrollY)))));
  const restoreScroll = () => {
    const saved = store.get(scrollKey);
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    const back = store.get('home-return') === '1' || nav?.type === 'back_forward';
    if (saved === null || !back) return;
    store.del('home-return');
    const y = Number(saved);
    const go = () => window.scrollTo({ top: y, behavior: 'instant' as ScrollBehavior });
    go();
    // Les polices et les images peuvent encore décaler la page : on recale une fois tout chargé, sauf si le visiteur a déjà bougé.
    let moved = false;
    const stop = () => (moved = true);
    addEventListener('wheel', stop, { once: true, passive: true });
    addEventListener('touchstart', stop, { once: true, passive: true });
    addEventListener('keydown', stop, { once: true });
    const settle = () => !moved && Math.abs(scrollY - y) > 2 && go();
    if (document.readyState === 'complete') requestAnimationFrame(settle);
    else addEventListener('load', settle, { once: true });
  };
  restoreScroll();
  addEventListener('pageshow', (e) => e.persisted && restoreScroll());

  // Filtres des projets.
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const items = document.querySelectorAll<HTMLElement>('.p-item');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      items.forEach((it) => {
        const show =
          f === 'all' ||
          (f === 'software' && it.dataset.category === 'software') ||
          (f === 'engineering' && it.dataset.category === 'engineering') ||
          (f === 'progress' && it.dataset.state === 'progress');
        it.classList.toggle('hidden', !show);
        if (show) it.classList.add('is-visible');
      });
    }),
  );

  // Lecture du parcours par facette : on estompe ce qui ne correspond pas.
  const facetBtns = document.querySelectorAll<HTMLButtonElement>('.facet');
  const facetItems = document.querySelectorAll<HTMLElement>('[data-facets]');
  facetBtns.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.facet || 'all';
      facetBtns.forEach((b) => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      facetItems.forEach((it) => {
        const keys = (it.dataset.facets || '').split(' ');
        it.classList.toggle('dim', f !== 'all' && !keys.includes(f));
      });
    }),
  );

  // Ligne de la frise qui se remplit au défilement.
  const line = document.querySelector<HTMLElement>('.tl-line');
  const fill = document.querySelector<HTMLElement>('.tl-fill');
  if (line && fill) {
    const update = () => {
      const r = line.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.6 - r.top) / r.height));
      fill.style.setProperty('--fill', String(p));
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  // Photos des formations en fondu enchaîné, décalées d'une carte à l'autre.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-slides]').forEach((art, n) => {
      const photos = art.querySelectorAll<HTMLElement>('.edu-photo');
      const dots = art.querySelectorAll<HTMLElement>('.edu-dots span');
      let i = 0;
      window.setTimeout(() => {
        window.setInterval(() => {
          if (document.hidden) return;
          photos[i].classList.remove('on');
          dots[i]?.classList.remove('on');
          i = (i + 1) % photos.length;
          photos[i].classList.add('on');
          dots[i]?.classList.add('on');
        }, 5200);
      }, n * 900);
    });
  }

  // Copier l'e-mail.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy || '');
        b.classList.add('done');
        b.title = b.dataset.done || '';
        setTimeout(() => b.classList.remove('done'), 1600);
      } catch {}
    }),
  );
</script>

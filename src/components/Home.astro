---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Hero from './Hero.astro';
import ProjectCard from './ProjectCard.astro';
import {
  certifications,
  education,
  experiences,
  facets,
  interests,
  languages,
  profile,
  skillDomains,
  softSkills,
} from '../data/profile';
import { projects } from '../data/projects';
import costume from '../assets/photos/costume.jpg';
import { missionPath, t, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// Vue d'ensemble en barres : positions en % entre septembre 2020 et la fin de l'année en cours.
const monthIdx = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  return y * 12 + m - 1;
};
const now = new Date();
const nowIdx = now.getFullYear() * 12 + now.getMonth() + (now.getDate() - 1) / 31;
const g0 = monthIdx('2020-09');
const g1 = now.getFullYear() * 12 + 12;
const pct = (i: number) => ((i - g0) / (g1 - g0)) * 100;
const bar = (span: { start: string; end?: string }) => {
  const a = monthIdx(span.start);
  const b = span.end ? monthIdx(span.end) + 1 : nowIdx;
  return { left: pct(a), width: Math.max(1.4, pct(b) - pct(a)), ongoing: !span.end };
};
const years = Array.from({ length: now.getFullYear() - 2020 }, (_, k) => 2021 + k).map((y) => ({ y, left: pct(y * 12) }));
// Les formations tiennent sur une seule ligne, de la première rentrée au dernier diplôme.
const school = {
  start: education.map((ed) => ed.span.start).sort()[0],
  end: education.every((ed) => ed.span.end) ? education.map((ed) => ed.span.end!).sort().at(-1) : undefined,
};
const ganttRows = [
  {
    label: lang === 'fr' ? 'Parcours scolaire' : 'Education',
    org: lang === 'fr' ? 'Prépa · Licence · Ingénieur · Mastère' : 'Prep · BSc · MEng · Post-master',
    kind: 'formation',
    facets: [] as string[],
    ...bar(school),
  },
  ...[...experiences].reverse().map((e) => ({ label: t(e.short, lang), org: e.company, kind: e.kind, facets: e.facets, ...bar(e.span) })),
];
const todayPct = pct(nowIdx);
const todayLabel = new Intl.DateTimeFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', { month: 'long', year: 'numeric' }).format(now);

const filters = [
  { key: 'all', label: t(ui.filters.all, lang), count: projects.length },
  { key: 'software', label: t(ui.filters.software, lang), count: projects.filter((p) => p.category === 'software').length },
  { key: 'engineering', label: t(ui.filters.engineering, lang), count: projects.filter((p) => p.category === 'engineering').length },
  { key: 'progress', label: t(ui.filters.progress, lang), count: projects.filter((p) => p.state === 'progress').length },
];
---

<Hero lang={lang} />

<!-- À propos -->
<section id="a-propos" class="section">
  <div class="container">
    <p class="eyebrow reveal">01 · {t(ui.nav.about, lang)}</p>
    <h2 class="section-title reveal">{t(ui.sections.about, lang)}</h2>
    <div class="about-grid">
      <div class="about-text reveal">
        {profile.about.map((p) => <p>{t(p, lang)}</p>)}
        <p class="loc muted"><Icon name="pin" size={16} /> {t(profile.location, lang)}</p>
      </div>
      <div class="about-visual reveal">
      <figure class="about-photo">
        <Image src={costume} alt={lang === 'fr' ? 'Jonathan Simo Kuate en costume' : 'Jonathan Simo Kuate in a suit'} widths={[360, 640]} sizes="(max-width: 980px) 70vw, 320px" loading="lazy" />
      </figure>
      <div class="terminal card" aria-hidden="true">
        <div class="term-bar"><span></span><span></span><span></span><em>~/jonathan $ cat profile.yml</em></div>
        <pre><code><span class="k">name</span>: <span class="s">Jonathan Simo Kuate</span>
<span class="k">role</span>: <span class="s">{t(profile.title, lang)}</span>
<span class="k">{lang === 'fr' ? 'diplomes' : 'degrees'}</span>:
  - <span class="s">{lang === 'fr' ? 'Ingénieur ECAM-EPMI (CTI)' : 'MEng ECAM-EPMI (CTI)'}</span>
  - <span class="s">{lang === 'fr' ? 'Mastère Spécialisé IMT-BS' : 'Post-master IMT-BS'}</span>
<span class="k">experience</span>:
  - <span class="s">Enedis</span>        <span class="c"># IEC 61850 · Python</span>
  - <span class="s">Alfa Laval</span>    <span class="c"># Java · API REST</span>
<span class="k">stack</span>: [<span class="s">Python</span>, <span class="s">Java</span>, <span class="s">Docker</span>, <span class="s">GitLab</span>]
<span class="k">{lang === 'fr' ? 'permis' : 'licence'}</span>: <span class="s">B</span>
<span class="k">status</span>: <span class="ok">{lang === 'fr' ? 'disponible immédiatement' : 'available now'}</span><span class="cursor">▍</span></code></pre>
      </div>
      </div>
    </div>
    <ul class="stats stagger">
      {profile.stats.map((s) => (
        <li class="card stat spotlight">
          <strong>
            {s.prefix}<span data-count={s.value}>{s.value}</span>{s.suffix}
          </strong>
          <span class="muted">{t(s.label, lang)}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Parcours -->
<section id="parcours" class="section">
  <div class="container">
    <p class="eyebrow reveal">02 · {t(ui.nav.experience, lang)}</p>
    <h2 class="section-title reveal">{t(ui.sections.experience, lang)}</h2>
    <p class="section-intro reveal">{t(ui.sections.experienceIntro, lang)}</p>

    <div class="gantt card reveal">
      <h3 class="gantt-title">{t(ui.exp.overview, lang)}</h3>
      <div class="g-body" style={`--today:${todayPct.toFixed(2)}`}>
        <div class="g-axis" aria-hidden="true">
          {years.map((y) => <span style={`--x:${y.left.toFixed(2)}`}>{y.y}</span>)}
        </div>
        <ul class="g-rows">
          {ganttRows.map((r, i) => (
            <li class:list={['g-row', r.kind]} data-facets={r.facets.join(' ')} style={`--i:${i}`}>
              <div class="g-label"><b>{r.label}</b><span>{r.org}</span></div>
              <div class="g-track">
                {years.map((y) => <i class="g-tick" style={`--x:${y.left.toFixed(2)}`}></i>)}
                <span class:list={['g-bar', { ongoing: r.ongoing }]} style={`--l:${r.left.toFixed(2)};--w:${r.width.toFixed(2)}`}></span>
              </div>
            </li>
          ))}
        </ul>
        <span class="g-today" aria-hidden="true"></span>
      </div>
      <ul class="g-legend">
        <li><i class="formation"></i>{t(ui.exp.formation, lang)}</li>
        <li><i class="alternance"></i>{t(ui.exp.alternance, lang)}</li>
        <li><i class="job"></i>{t(ui.exp.job, lang)}</li>
        <li><i class="today"></i>{todayLabel}</li>
      </ul>
    </div>

    <div class="facets reveal" role="group" aria-label={t(ui.exp.facets, lang)}>
      <span class="facets-label">{t(ui.exp.facets, lang)}</span>
      <button type="button" class="facet active" data-facet="all" aria-pressed="true">{t(ui.exp.all, lang)}</button>
      {facets.map((f) => (
        <button type="button" class="facet" data-facet={f.key} aria-pressed="false"><i class={`dot f-${f.key}`}></i>{t(f.label, lang)}</button>
      ))}
    </div>

    <ol class="timeline">
      <span class="tl-line" aria-hidden="true"><span class="tl-fill"></span></span>
      {experiences.map((e) => (
        <li class="tl-item reveal" data-facets={e.facets.join(' ')}>
          <span class="tl-logo" style={`--h:${e.hue}`} aria-hidden="true">{e.initials}</span>
          <div class="tl-body card spotlight">
            <div class="tl-head">
              <div>
                <h3>{t(e.role, lang)}</h3>
                <p class="company">
                  {e.url ? <a href={e.url} target="_blank" rel="noopener">{e.company}</a> : e.company}
                  <span class="muted"> · {t(e.place, lang)}</span>
                </p>
              </div>
              <div class="tl-when">
                {e.current && <span class="now"><span class="pulse"></span>{t(ui.exp.current, lang)}</span>}
                <span>{t(e.period, lang)}</span>
                <span class="muted">{t(e.type, lang)}</span>
              </div>
            </div>
            <p class="tl-summary">{t(e.summary, lang)}</p>
            <ul class="bubbles" aria-label={t(ui.exp.keyMissions, lang)}>
              {e.bubbles.map((b, i) => (
                <li class="bubble" style={`--i:${i}`}><Icon name={b.icon} size={16} /> {t(b.label, lang)}</li>
              ))}
            </ul>
            <ul class="points">
              {e.points.map((pt) => <li>{t(pt, lang)}</li>)}
            </ul>
            {e.media && (
              <figure class="tl-media">
                <div class="tl-media-row">
                  {e.media.photo && (
                    <Image
                      src={e.media.photo}
                      alt={t(e.media.caption, lang)}
                      widths={[280, 560]}
                      sizes="280px"
                      loading="lazy"
                      style={`aspect-ratio:${e.media.ratio ?? '4 / 5'}`}
                    />
                  )}
                  {e.media.video && (
                    <video src={e.media.video.src} poster={e.media.video.poster} autoplay muted loop playsinline preload="none" aria-label={t(e.media.caption, lang)}></video>
                  )}
                  {e.media.logo && (
                    <span class="tl-logo-tile">
                      <Image src={e.media.logo} alt={e.company} widths={[150]} sizes="150px" loading="lazy" />
                    </span>
                  )}
                  {e.media.panel && (
                    <div class="tl-panel" style={`--h:${e.hue}`} aria-hidden="true">
                      <span class="tl-panel-icons">
                        {e.media.panel.icons.map((ic, i) => <span style={`--i:${i}`}><Icon name={ic} size={20} /></span>)}
                      </span>
                      <span class="tl-panel-title">{e.media.panel.title}</span>
                      <span class="tl-panel-sub">{t(e.media.panel.sub, lang)}</span>
                      {e.media.panel.badge && <span class="tl-panel-badge">{t(e.media.panel.badge, lang)}</span>}
                    </div>
                  )}
                </div>
                <figcaption class="muted"><Icon name={e.media.icon ?? 'pin'} size={14} /> {t(e.media.caption, lang)}</figcaption>
              </figure>
            )}
            {e.details && (
              <details>
                <summary>
                  <span class="more">{t(ui.exp.more, lang)}</span>
                  <span class="less">{t(ui.exp.less, lang)}</span>
                  <Icon name="chevron" size={16} />
                </summary>
                <ul class="points">{e.details.map((d) => <li>{t(d, lang)}</li>)}</ul>
              </details>
            )}
            <ul class="tags">{e.tags.map((tg) => <li class="tag">{tg}</li>)}</ul>
            {e.mission && (
              <a class="mission-link" href={missionPath(e.mission, lang)}>
                {t(ui.exp.mission, lang)} <Icon name="arrowRight" size={16} />
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Projets -->
<section id="projets" class="section">
  <div class="container">
    <p class="eyebrow reveal">03 · {t(ui.nav.projects, lang)}</p>
    <h2 class="section-title reveal">{t(ui.sections.projectsTitle, lang)}</h2>
    <p class="section-intro reveal">{t(ui.sections.projectsIntro, lang)}</p>
    <p class="evolving reveal"><span class="pulse"></span>{t(ui.project.evolvingBadge, lang)}</p>
    <div class="filters reveal" role="tablist" aria-label={t(ui.nav.projects, lang)}>
      {filters.map((f, i) => (
        <button type="button" class:list={['filter', { active: i === 0 }]} data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label} <span class="count">{f.count}</span>
        </button>
      ))}
    </div>
    <div class="projects-grid">
      {projects.map((p) => (
        <div
          class="p-item reveal"
          data-category={p.category}
          data-state={p.state}
        >
          <ProjectCard project={p} lang={lang} />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Formations -->
<section id="formations" class="section">
  <div class="container">
    <p class="eyebrow reveal">04 · {t(ui.sections.education, lang)}</p>
    <h2 class="section-title reveal">{t(ui.sections.education, lang)}</h2>
    <p class="section-intro reveal">{t(ui.sections.educationIntro, lang)}</p>
    <ul class="edu-grid stagger">
      {education.map((ed) => (
        <li class="card edu spotlight">
          <div class:list={['edu-art', { 'has-photo': ed.photos?.length }]} style={`--h:${ed.hue}`} data-slides={ed.photos && ed.photos.length > 1 ? '' : undefined}>
            {ed.photos?.map((ph, i) => (
              <Image src={ph} alt="" class:list={['edu-photo', { on: i === 0 }]} widths={[560, 900]} sizes="(max-width: 720px) 92vw, 560px" loading="lazy" />
            ))}
            {ed.photos && ed.photos.length > 1 && (
              <span class="edu-dots" aria-hidden="true">{ed.photos.map((_, i) => <span class:list={{ on: i === 0 }}></span>)}</span>
            )}
            <span class="edu-initials" aria-hidden="true">{ed.initials}</span>
            <Icon name="graduation" size={30} class="edu-cap" />
            <span class="edu-year" aria-hidden="true">{ed.period}</span>
          </div>
          <div class="edu-body">
            {ed.highlight && <p class="edu-highlight"><Icon name="award" size={14} /> {t(ed.highlight, lang)}</p>}
            <h3>{t(ed.degree, lang)}</h3>
            <p class="school">
              {ed.url ? <a href={ed.url} target="_blank" rel="noopener">{ed.school}</a> : ed.school}
              <span class="muted"> · {t(ed.place, lang)}</span>
            </p>
            <p class="muted small">{t(ed.detail, lang)}</p>
            <p class="learned-title">{t(ui.edu.learned, lang)}</p>
            <ul class="tags">{ed.learned.map((l) => <li class="tag">{t(l, lang)}</li>)}</ul>
            {ed.diploma && (
              <a class="edu-foot" href={ed.diploma.href} target="_blank" rel="noopener">
                <span class="edu-doc" aria-hidden="true">
                  <Image src={ed.diploma.thumb} alt="" widths={[120, 240]} sizes="96px" loading="lazy" />
                </span>
                <span class="link diploma"><Icon name="external" size={16} /> {t(ed.diploma.kind === 'diploma' ? ui.edu.diploma : ui.edu.attestation, lang)}</span>
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Compétences -->
<section id="competences" class="section">
  <div class="container">
    <p class="eyebrow reveal">05 · {t(ui.nav.skills, lang)}</p>
    <h2 class="section-title reveal">{t(ui.sections.skills, lang)}</h2>
    <p class="section-intro reveal">{t(ui.sections.skillsIntro, lang)}</p>
    <div class="skills-grid stagger">
      {skillDomains.map((d) => (
        <div class="card skill spotlight" style={`--h:${d.hue}`}>
          <div class="skill-head">
            <span class="skill-icon"><Icon name={d.icon} size={22} /></span>
            <h3>{t(d.title, lang)}</h3>
          </div>
          <p class="muted small">{t(d.desc, lang)}</p>
          <ul class="skill-items">{d.items.map((s) => <li>{s}</li>)}</ul>
          <p class="used">
            <span>{lang === 'fr' ? 'Mis en pratique' : 'Applied at'}</span>
            {d.usedAt.map((u) => <b>{u}</b>)}
          </p>
        </div>
      ))}
    </div>
    <div class="soft reveal">
      <h3 class="sub-title">{t(ui.sections.soft, lang)}</h3>
      <ul class="soft-grid">
        {softSkills.map((s) => (
          <li>
            <span class="soft-icon"><Icon name={s.icon} size={18} /></span>
            <h4>{t(s.title, lang)}</h4>
            <p class="muted">{t(s.proof, lang)}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="extra-grid">
      <div class="reveal">
        <h3 class="sub-title">{t(ui.sections.certifications, lang)}</h3>
        <ul class="certs">
          {certifications.map((c) => (
            <li class="cert card spotlight">
              <span class:list={['cert-icon', { progress: c.status === 'progress' }]}>
                <Icon name={c.status === 'progress' ? 'sparkles' : 'award'} size={18} />
              </span>
              <div class="cert-text">
                <p class="cert-name">{t(c.name, lang)}</p>
                <p class="muted small">{c.issuer} · {t(c.date, lang)}</p>
              </div>
              {c.url && (
                <a class="verify" href={c.url} target="_blank" rel="noopener">{t(c.urlKind === 'doc' ? ui.project.doc : ui.project.verify, lang)} <Icon name="external" size={14} /></a>
              )}
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal">
        <h3 class="sub-title">{t(ui.sections.languages, lang)}</h3>
        <ul class="langs">
          {languages.map((l) => (
            <li>
              <div class="lang-row"><strong>{t(l.name, lang)}</strong><span class="muted">{t(l.level, lang)}</span></div>
              <span class="bar"><span style={`--v:${l.value}%`}></span></span>
            </li>
          ))}
        </ul>
        <h3 class="sub-title">{t(ui.sections.interests, lang)}</h3>
        <ul class="interests">
          {interests.map((i) => (
            <li class="card"><Icon name={i.icon} size={20} /> <span>{t(i.label, lang)}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Contact -->
<section id="contact" class="section">
  <div class="container">
    <div class="contact card reveal">
      <div class="contact-glow" aria-hidden="true"></div>
      <p class="eyebrow">06 · {t(ui.nav.contact, lang)}</p>
      <h2>{t(ui.sections.contact, lang)}</h2>
      <p class="muted intro">{t(ui.contact.text, lang)}</p>
      <ul class="channels">
        <li>
          <a class="channel card" href={`mailto:${profile.email}`}>
            <Icon name="mail" size={22} />
            <span><b>E-mail</b><span class="muted">{profile.email}</span></span>
          </a>
          <button type="button" class="copy" data-copy={profile.email} data-done={t(ui.contact.copied, lang)} aria-label={t(ui.contact.copy, lang)}>
            <Icon name="copy" size={16} />
          </button>
        </li>
        <li>
          <a class="channel card" href={profile.phoneHref}>
            <Icon name="phone" size={22} />
            <span><b>{lang === 'fr' ? 'Téléphone' : 'Phone'}</b><span class="muted">{profile.phone}</span></span>
          </a>
        </li>
        <li>
          <a class="channel card" href={profile.linkedin} target="_blank" rel="noopener">
            <Icon name="linkedin" size={22} />
            <span><b>LinkedIn</b><span class="muted">jonathan-simo</span></span>
          </a>
        </li>
        <li>
          <a class="channel card" href={profile.github} target="_blank" rel="noopener">
            <Icon name="github" size={22} />
            <span><b>GitHub</b><span class="muted">Jonathan0237</span></span>
          </a>
        </li>
      </ul>
      <a href={profile.cv} class="btn btn-primary" download><Icon name="download" size={18} /> {t(ui.hero.downloadCv, lang)}</a>
    </div>
  </div>
</section>

<style>
  /* À propos */
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .about-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 1.05rem;
  }
  .loc {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
  }
  .about-visual {
    position: relative;
    padding: 0 0 0 36px;
  }
  .about-photo {
    margin: 0;
    width: 62%;
    aspect-ratio: 4 / 5;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    transform: rotate(-3deg);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .about-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-visual:hover .about-photo {
    transform: rotate(0deg) scale(1.02);
  }
  .about-visual .terminal {
    position: relative;
    margin: -120px 0 0 22%;
    z-index: 1;
  }
  .terminal {
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }
  .term-bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ef4444;
  }
  .term-bar span:nth-child(2) { background: #f59e0b; }
  .term-bar span:nth-child(3) { background: #22c55e; }
  .term-bar em {
    margin-left: 10px;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .terminal pre {
    margin: 0;
    padding: 22px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.85;
    overflow-x: auto;
  }
  .k { color: var(--accent); }
  .c { color: var(--text-muted); font-style: italic; }
  .ok { color: #22c55e; font-weight: 600; }
  .cursor { animation: blink 1.1s steps(1) infinite; color: var(--accent); }
  @keyframes blink { 50% { opacity: 0; } }
  .stats {
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .stat {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .stat strong {
    font-size: 2.6rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat .muted {
    font-size: 0.92rem;
  }

  /* Parcours */
  .gantt {
    padding: 26px 28px 20px;
    margin-bottom: 22px;
  }
  .gantt-title {
    font-size: 1.05rem;
    margin-bottom: 18px;
  }
  .g-body {
    --lw: 270px;
    position: relative;
  }
  .g-axis {
    position: relative;
    height: 22px;
    margin-left: var(--lw);
    border-bottom: 1px solid var(--border);
    margin-bottom: 6px;
  }
  .g-axis span {
    position: absolute;
    left: calc(var(--x) * 1%);
    bottom: 5px;
    padding-left: 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    border-left: 1px solid var(--border);
  }
  .g-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .g-row {
    display: grid;
    grid-template-columns: var(--lw) 1fr;
    align-items: center;
    min-height: 46px;
    transition: opacity 0.3s ease;
  }
  .g-row.dim,
  .tl-item.dim {
    opacity: 0.28;
  }
  .g-label {
    display: flex;
    flex-direction: column;
    padding-right: 16px;
    line-height: 1.3;
  }
  .g-label b {
    font-size: 0.88rem;
  }
  .g-label span {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .g-track {
    position: relative;
    height: 100%;
    min-height: 46px;
  }
  .g-tick {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: calc(var(--x) * 1%);
    border-left: 1px dashed var(--border);
  }
  .g-bar {
    position: absolute;
    top: 50%;
    left: calc(var(--l) * 1%);
    width: calc(var(--w) * 1%);
    height: 14px;
    margin-top: -7px;
    border-radius: 999px;
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: calc(0.1s + var(--i) * 0.06s);
  }
  .gantt.is-visible .g-bar {
    transform: scaleX(1);
  }
  .formation .g-bar,
  .g-legend .formation {
    background: linear-gradient(90deg, color-mix(in srgb, #a5b4fc 35%, transparent), #a5b4fc);
  }
  .alternance .g-bar,
  .g-legend .alternance {
    background: var(--gradient);
  }
  .job .g-bar,
  .g-legend .job {
    background: #3b82f6;
  }
  .g-bar.ongoing {
    border-radius: 999px 4px 4px 999px;
    background-image: repeating-linear-gradient(-45deg, rgb(255 255 255 / 0.25) 0 6px, transparent 6px 12px);
    background-color: #3b82f6;
  }
  .g-today {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--lw) + (100% - var(--lw)) * var(--today) / 100);
    border-left: 2px dashed #f97316;
    pointer-events: none;
  }
  .g-legend {
    list-style: none;
    margin: 14px 0 0;
    padding: 12px 0 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .g-legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .g-legend i {
    display: inline-block;
    width: 18px;
    height: 8px;
    border-radius: 999px;
  }
  .g-legend i.today {
    width: 0;
    height: 14px;
    border-radius: 0;
    border-left: 2px dashed #f97316;
  }
  .g-bar.ongoing::after {
    content: '';
    position: absolute;
    right: -5px;
    top: 50%;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border-radius: 50%;
    background: #22c55e;
    animation: ping 2.2s infinite;
  }
  .facets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    margin-bottom: 30px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-elev);
  }
  .facets-label {
    margin-right: 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .facet {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 13px;
    border-radius: 999px;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .facet:hover {
    border-color: var(--accent);
  }
  .facet.active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }
  .facet .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .f-systemes { background: hsl(200 80% 55%); }
  .f-dev { background: hsl(265 75% 65%); }
  .f-client { background: hsl(340 80% 62%); }
  .f-orga { background: hsl(40 90% 55%); }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .tl-line {
    position: absolute;
    left: 23px;
    top: 24px;
    bottom: 24px;
    width: 2px;
    background: var(--border);
    border-radius: 2px;
  }
  .tl-fill {
    position: absolute;
    inset: 0;
    background: var(--gradient);
    transform-origin: top;
    transform: scaleY(var(--fill, 0));
    border-radius: 2px;
  }
  .tl-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 24px;
    margin-bottom: 20px;
    position: relative;
  }
  .tl-logo {
    position: relative;
    z-index: 1;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    color: #fff;
    background: linear-gradient(135deg, hsl(var(--h) 75% 50%), hsl(calc(var(--h) + 40) 70% 40%));
    box-shadow: 0 0 0 6px var(--bg);
    margin-top: 18px;
  }
  .tl-body {
    padding: 24px 26px;
  }
  .tl-body:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }
  .tl-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .tl-head h3 {
    font-size: 1.2rem;
  }
  .company {
    margin-top: 4px;
    font-weight: 600;
    color: var(--accent);
  }
  .company a:hover {
    text-decoration: underline;
  }
  .tl-when {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-align: right;
  }
  .now {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #22c55e;
    font-weight: 600;
  }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    animation: ping 2.2s infinite;
  }
  @keyframes ping {
    0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6); }
    70% { box-shadow: 0 0 0 8px rgba(34, 197, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
  }
  .mission-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 9px 16px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    transition: gap 0.25s ease, background 0.25s ease;
  }
  .mission-link:hover {
    gap: 12px;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .tl-media {
    margin: 0 0 16px;
  }
  .tl-media-row {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tl-media-row::-webkit-scrollbar {
    display: none;
  }
  .tl-media-row :global(img),
  .tl-media-row video {
    display: block;
    flex: none;
    height: 240px;
    width: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: var(--bg-soft);
  }
  .tl-media-row video {
    aspect-ratio: 9 / 16;
  }
  .tl-logo-tile {
    flex: none;
    display: grid;
    place-items: center;
    width: 200px;
    height: 240px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: #fff;
  }
  .tl-logo-tile :global(img) {
    height: auto;
    width: 160px;
    aspect-ratio: auto;
    border: 0;
    border-radius: 0;
    background: transparent;
  }
  .tl-panel {
    position: relative;
    flex: none;
    width: 340px;
    max-width: 100%;
    height: 240px;
    padding: 22px;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #fff;
    background:
      radial-gradient(90% 90% at 100% 0%, hsl(var(--h) 70% 45% / 0.9), transparent 70%),
      radial-gradient(80% 80% at 0% 100%, hsl(calc(var(--h) + 40) 60% 30%), transparent 70%),
      hsl(var(--h) 45% 16%);
  }
  .tl-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.14) 1px, transparent 1px);
    background-size: 14px 14px;
  }
  .tl-panel-icons {
    position: absolute;
    top: 20px;
    right: 20px;
    display: grid;
    grid-template-columns: repeat(2, 44px);
    gap: 10px;
  }
  .tl-panel-icons span {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.2);
    backdrop-filter: blur(4px);
    animation: float 5s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.2s);
  }
  .tl-panel-title {
    position: relative;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .tl-panel-sub {
    position: relative;
    margin-top: 4px;
    font-size: 0.9rem;
    opacity: 0.85;
  }
  .tl-panel-badge {
    position: relative;
    align-self: flex-start;
    margin-top: 12px;
    padding: 4px 11px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: rgb(255 255 255 / 0.16);
    border: 1px solid rgb(255 255 255 / 0.28);
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  .bubbles {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .bubble {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px 7px 10px;
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 9%, var(--bg-soft));
    border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border));
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }
  .bubble :global(svg) {
    color: var(--accent);
  }
  .bubble:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .tl-item.is-visible .bubble {
    animation: pop 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.3) both;
    animation-delay: calc(0.15s + var(--i) * 0.06s);
  }
  @keyframes pop {
    from { opacity: 0; transform: scale(0.85) translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  .tl-summary {
    margin-top: 14px;
    color: var(--text-muted);
    font-size: 0.97rem;
  }
  .points {
    margin: 14px 0 16px;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 0.96rem;
  }
  .points li::marker {
    color: var(--accent);
  }
  details {
    margin: -4px 0 16px;
  }
  details .points {
    margin-top: 12px;
    animation: open 0.35s ease;
  }
  @keyframes open {
    from { opacity: 0; transform: translateY(-6px); }
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent);
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary :global(svg) {
    transition: transform 0.25s ease;
  }
  details[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  .less,
  details[open] .more {
    display: none;
  }
  details[open] .less {
    display: inline;
  }

  /* Formations */
  .edu-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .edu {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .edu:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .edu-art {
    position: relative;
    height: 150px;
    background:
      radial-gradient(120% 120% at 100% 0%, hsl(var(--h) 80% 55% / 0.55), transparent 60%),
      radial-gradient(100% 100% at 0% 100%, hsl(calc(var(--h) + 60) 70% 50% / 0.4), transparent 60%),
      var(--bg-soft);
    overflow: hidden;
  }
  .edu-art.has-photo {
    height: 230px;
  }
  :global(.edu-photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
    opacity: 0;
    transition: transform 0.8s ease, opacity 1.2s ease;
  }
  :global(.edu-photo.on) {
    opacity: 1;
  }
  .edu-dots {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    display: flex;
    gap: 5px;
  }
  .edu-dots span {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.55);
    transition: width 0.4s ease, background 0.4s ease;
  }
  .edu-dots span.on {
    width: 18px;
    background: #fff;
  }
  .edu:hover :global(.edu-photo) {
    transform: scale(1.05);
  }
  .edu-art.has-photo::after {
    background: linear-gradient(180deg, transparent 45%, rgb(0 0 0 / 0.55));
    opacity: 1;
  }
  .edu-art.has-photo .edu-initials {
    color: #fff;
  }
  .edu-art.has-photo .edu-initials {
    display: none;
  }
  .edu-art.has-photo :global(.edu-cap) {
    display: none;
  }
  .edu-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--border) 1px, transparent 1px);
    background-size: 14px 14px;
    opacity: 0.7;
  }
  .edu-initials {
    position: absolute;
    left: 22px;
    bottom: 10px;
    font-size: 3.4rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--text);
    opacity: 0.9;
    z-index: 1;
    transition: transform 0.4s ease;
  }
  .edu:hover .edu-initials {
    transform: translateX(6px);
  }
  :global(.edu-cap) {
    position: absolute;
    right: 22px;
    top: 20px;
    z-index: 1;
    color: var(--text);
    opacity: 0.8;
    transition: transform 0.4s ease;
  }
  .edu:hover :global(.edu-cap) {
    transform: rotate(-12deg) translateY(-4px);
  }
  .edu-foot {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px dashed var(--border);
  }
  .edu-doc {
    flex: none;
    width: 84px;
    max-height: 64px;
    border-radius: 5px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgb(0 0 0 / 0.12);
    box-shadow: 0 10px 22px -12px rgb(0 0 0 / 0.5);
    transform: rotate(-4deg);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .edu-doc :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: top;
  }
  .edu-foot:hover .edu-doc,
  .edu-foot:focus-visible .edu-doc {
    transform: rotate(0deg) translateY(-3px) scale(1.06);
  }
  .edu-highlight {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
    color: var(--accent);
    background: var(--accent-soft);
  }
  .edu-year {
    position: absolute;
    left: 24px;
    top: 16px;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 3px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elev) 80%, transparent);
  }
  .edu-body {
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .edu-body h3 {
    font-size: 1.15rem;
  }
  .school {
    font-weight: 600;
    color: var(--accent);
    font-size: 0.95rem;
  }
  .small {
    font-size: 0.9rem;
  }
  .learned-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 6px;
  }
  .diploma {
    font-size: 0.9rem;
  }

  /* Projets */
  .evolving {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: -8px 0 26px;
    padding: 8px 16px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    background: var(--bg-soft);
    border: 1px solid var(--border);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }
  .filter {
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text-muted);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
  }
  .filter:hover {
    color: var(--text);
    border-color: var(--accent);
  }
  .filter.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 1px 7px;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 15%, transparent);
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .p-item {
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .p-item.hidden {
    display: none;
  }

  /* Compétences */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  /* Dernière ligne incomplète sur 3 colonnes : la dernière carte prend la place libre. */
  @media (min-width: 981px) {
    .skills-grid > .skill:last-child:nth-child(3n + 2) {
      grid-column: span 2;
    }
  }
  .skill {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .skill:hover {
    transform: translateY(-4px);
    border-color: hsl(var(--h) 70% 55% / 0.6);
  }
  .skill-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .skill-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    color: hsl(var(--h) 75% 45%);
    background: hsl(var(--h) 75% 50% / 0.12);
    flex-shrink: 0;
  }
  :global([data-theme='dark']) .skill-icon {
    color: hsl(var(--h) 85% 70%);
  }
  .skill h3 {
    font-size: 1.05rem;
  }
  .skill-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .skill-items li {
    font-size: 0.8rem;
    padding: 5px 10px;

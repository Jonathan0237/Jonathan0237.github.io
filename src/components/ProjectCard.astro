---
import Icon from './Icon.astro';
import ProjectCover from './ProjectCover.astro';
import { projectName, type Project } from '../data/projects';
import { projectPath, t, ui, type Lang } from '../i18n';

interface Props {
  project: Project;
  lang: Lang;
}
const { project: p, lang } = Astro.props;
const name = projectName(p, lang);
const href = projectPath(p.slug, lang);
---

<article class="card project spotlight">
  <a href={href} class="cover-link" tabindex="-1" aria-hidden="true">
    <ProjectCover project={p} alt={name} />
  </a>
  <div class="body">
    <div class="meta">
      <span class:list={['badge', 'cat', p.category]}>
        <Icon name={p.category === 'software' ? 'code' : 'chip'} size={12} />
        {t(ui.categories[p.category], lang)}
      </span>
      <span class:list={['badge', 'state', p.state]}>
        {p.state === 'progress' && <span class="live" aria-hidden="true"></span>}
        {t(ui.states[p.state], lang)}
      </span>
      {p.confidential && (
        <span class="badge soft"><Icon name="lock" size={12} /> {t(ui.filters.company, lang)}</span>
      )}
      {p.video && (
        <span class="badge soft"><Icon name="play" size={11} /> {t(ui.project.videoBadge, lang)}</span>
      )}
    </div>
    <h3><a href={href} class="title">{name}</a></h3>
    <p class="period">{t(p.period, lang)}</p>
    <p class="muted summary">{t(p.summary, lang)}</p>
    <ul class="tags">
      {p.stack.slice(0, 5).map((s) => <li class="tag">{s}</li>)}
    </ul>
    <div class="links">
      <a href={href} class="link">{t(ui.project.caseStudy, lang)} <Icon name="arrowRight" size={16} /></a>
      {p.repo && (
        <a href={p.repo} class="link subtle" target="_blank" rel="noopener"><Icon name="github" size={16} /> {t(ui.project.code, lang)}</a>
      )}
    </div>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    padding: 10px;
    height: 100%;
  }
  .project:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    transform: translateY(-5px);
    box-shadow: var(--shadow);
  }
  .project:hover :global(.phone),
  .project:hover :global(.glyph) {
    transform: translateY(-6px) scale(1.02);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 14px 14px;
    flex: 1;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border-radius: 999px;
    font-weight: 600;
    border: 1px solid transparent;
  }
  .cat.software {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .cat.engineering {
    background: color-mix(in srgb, var(--accent-3) 15%, transparent);
    color: var(--accent-3);
  }
  .state {
    border-color: var(--border);
    color: var(--text-muted);
  }
  .state.progress {
    color: #22c55e;
    border-color: color-mix(in srgb, #22c55e 40%, transparent);
  }
  .live {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    animation: ping 2s infinite;
  }
  @keyframes ping {
    0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6); }
    70% { box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
  }
  .badge.soft {
    background: var(--bg-soft);
    color: var(--text-muted);
    border-color: var(--border);
  }
  h3 {
    font-size: 1.3rem;
    margin-top: 2px;
  }
  .title:hover {
    color: var(--accent);
  }
  .period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: -4px;
  }
  .summary {
    font-size: 0.95rem;
  }
  .links {
    margin-top: auto;
    padding-top: 6px;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-size: 0.9rem;
  }
  .subtle {
    color: var(--text-muted);
  }
</style>
